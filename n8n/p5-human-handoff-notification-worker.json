      "credentials": {
        "postgres": {
          "id": "7USUIiXw7zZtcDkC",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n    h.handoff_id,\n    h.call_id,\n    c.provider_call_id,\n\n    h.prospect_id,\n    h.opportunity_id,\n    h.conversation_id,\n\n    h.source_channel,\n    h.reason_code,\n    h.priority,\n    h.requested_by,\n\n    h.conversation_summary,\n    h.sensitive_topic_detected,\n    h.caller_explicitly_requested_human,\n\n    h.recommended_next_action,\n\n    h.transfer_mode,\n    h.transfer_destination_alias,\n    h.transfer_result,\n\n    h.handoff_status,\n    h.requested_at\n\nfrom public.human_handoffs as h\n\nleft join public.calls as c\n    on c.call_id = h.call_id\n\nwhere h.handoff_id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [ $('Claim Handoff Event PG').first().json.aggregate_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        640,
        80
      ],
      "id": "38d3433c-fa48-4c4b-84c7-e31e9f957ed8",
      "name": "Load Handoff Details PG",
      "credentials": {
        "postgres": {
          "id": "7USUIiXw7zZtcDkC",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const h = $json;\n\nconst reasonLabels = {\n  EXPLICIT_HUMAN_REQUEST: 'Caller requested a human',\n  SENSITIVE_OR_CLINICAL: 'Sensitive or clinical issue',\n  LOW_CONFIDENCE: 'Low-confidence case',\n  UNSUPPORTED_KNOWLEDGE: 'Unsupported knowledge request',\n  HIGH_VALUE_OPPORTUNITY: 'High-value opportunity',\n  CALLER_FRUSTRATION: 'Caller frustration',\n  BOOKING_FAILURE: 'Booking failure',\n  TOOL_FAILURE: 'Tool failure',\n  CONFLICTING_INTENT: 'Conflicting intent',\n  OUT_OF_SCOPE: 'Out-of-scope request',\n};\n\nconst reasonLabel =\n  reasonLabels[h.reason_code] ?? h.reason_code ?? 'Human review required';\n\nconst priority =\n  h.priority ?? 'NORMAL';\n\nconst subject =\n  `[${priority}] Human handoff requested — ${reasonLabel}`;\n\nconst body = [\n  'A caller requires human follow-up.',\n  '',\n  `Priority: ${priority}`,\n  `Reason: ${reasonLabel}`,\n  `Requested by: ${h.requested_by ?? 'UNKNOWN'}`,\n  `Caller explicitly requested human: ${\n    h.caller_explicitly_requested_human === true ? 'Yes' : 'No'\n  }`,\n  `Channel: ${h.source_channel ?? 'UNKNOWN'}`,\n  '',\n  `Recommended action: ${\n    h.recommended_next_action ?? 'Human review and follow-up.'\n  }`,\n  '',\n  `Handoff ID: ${h.handoff_id}`,\n  `Call ID: ${h.call_id ?? 'N/A'}`,\n  `Provider Call ID: ${h.provider_call_id ?? 'N/A'}`,\n  `Requested at: ${h.requested_at ?? 'N/A'}`,\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      ...h,\n\n      notification: {\n        subject,\n        body,\n        priority,\n        reason_code: h.reason_code,\n        reason_label: reasonLabel,\n      },\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        80
      ],
      "id": "285f3d50-e9e3-40cd-a121-3bffc2b4ffea",
      "name": "Build Handoff Notification"
    },
    {
      "parameters": {
        "fromEmail": "johncarlbacunawa94@gmail.com",
        "toEmail": "johncarlbacunawa94@gmail.com",
        "subject": "={{ $json.notification.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.notification.body }}",
        "options": {}
