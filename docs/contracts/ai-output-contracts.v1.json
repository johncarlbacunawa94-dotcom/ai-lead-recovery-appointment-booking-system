{
  "contract_version": "1.0",

  "schemas": {

    "IntentInterpretationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_intent",
        "secondary_intents",
        "location",
        "commercial_goal",
        "qualification_signals",
        "sensitive_topic_detected",
        "human_requested",
        "confidence"
      ],
      "properties": {
        "primary_intent": {
          "type": "string",
          "enum": [
            "PROFESSIONAL_TRAINING",
            "BUSINESS_PARTNERSHIP",
            "GENERAL_SERVICE",
            "UNKNOWN"
          ]
        },
        "secondary_intents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PROFESSIONAL_TRAINING",
              "BUSINESS_PARTNERSHIP",
              "GENERAL_SERVICE",
              "UNKNOWN"
            ]
          }
        },
        "location": {
          "type": "string",
          "enum": [
            "BRISBANE",
            "MELBOURNE",
            "SYDNEY",
            "PERTH",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "commercial_goal": {
          "type": ["string", "null"]
        },
        "qualification_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive_topic_detected": {
          "type": "boolean"
        },
        "human_requested": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },

    "PostCallAnalysisV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "primary_intent",
        "qualification_result",
        "main_objection",
        "questions_asked",
        "unresolved_questions",
        "sensitive_topic_detected",
        "caller_requested_human",
        "booking_discussed",
        "booking_outcome",
        "recommended_next_action",
        "follow_up_required",
        "confidence"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "primary_intent": {
          "type": "string",
          "enum": [
            "PROFESSIONAL_TRAINING",
            "BUSINESS_PARTNERSHIP",
            "GENERAL_SERVICE",
            "UNKNOWN"
          ]
        },
        "qualification_result": {
          "type": "string",
          "enum": [
            "QUALIFIED",
            "REVIEW_REQUIRED",
            "UNQUALIFIED",
            "UNKNOWN"
          ]
        },
        "main_objection": {
          "type": ["string", "null"]
        },
        "questions_asked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive_topic_detected": {
          "type": "boolean"
        },
        "caller_requested_human": {
          "type": "boolean"
        },
        "booking_discussed": {
          "type": "boolean"
        },
        "booking_outcome": {
          "type": "string",
          "enum": [
            "NOT_DISCUSSED",
            "AVAILABILITY_CHECKED",
            "BOOKED",
            "SLOT_UNAVAILABLE",
            "FAILED",
            "HUMAN_REQUIRED"
          ]
        },
        "recommended_next_action": {
          "type": ["string", "null"]
        },
        "follow_up_required": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}